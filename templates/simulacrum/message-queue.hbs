{{!-- Queued user messages: shown in submission order while the agent is busy --}}
<div class="simulacrum-message-queue chat-message message flexcol" data-simulacrum-queue>
    {{#if messages.length}}
    <div class="message-content simulacrum-queue-content">
        <div class="simulacrum-queue-header">
            <span class="simulacrum-queue-title">
                <i class="fa-solid fa-hourglass-half"></i> Queued messages ({{messages.length}})
            </span>
            <button type="button" class="ui-control simulacrum-queue-action-icon fa-solid fa-trash"
                data-tooltip aria-label="Discard all queued messages" data-queue-action="discardAll"></button>
        </div>
        <ol class="simulacrum-queue-list">
            {{#each messages}}
            <li class="simulacrum-queued-message" data-queue-id="{{this.id}}">
                <span class="simulacrum-queue-position">{{this.position}}</span>
                <span class="simulacrum-queued-message-content">{{this.content}}</span>
                <button type="button" class="ui-control simulacrum-queue-action-icon fa-solid fa-times"
                    data-tooltip aria-label="Discard queued message" data-queue-action="discard"
                    data-queue-id="{{this.id}}"></button>
            </li>
            {{/each}}
        </ol>
        <p class="simulacrum-queue-hint">
            {{#if isProcessing}}
            Sent automatically after the current response, in order.
            {{else}}
            Press Send to run the next queued message.
            {{/if}}
        </p>
    </div>
</div>
{{/if}}
